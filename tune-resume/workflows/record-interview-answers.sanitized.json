              "name": "note",
              "value": "={{ (($json.files || [])[0] ? 'Found \"' + $json.files[0].name + '\" but it is a native Google file (' + $json.files[0].mimeType + '), which a raw media upload cannot rewrite. Convert it to a plain .md or .txt file to enable write-back.' : 'No file named \"' + ($('When Executed by Another Workflow').first().json.fileName || '1_MASTER_FACTS.md') + '\" was found in the source folder.') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "The interview answers are still used for the current run - only the permanent write-back is skipped. This branch never fails the parent."
    }
