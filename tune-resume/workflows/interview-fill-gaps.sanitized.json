    {
      "id": "iv-0016",
      "name": "Restore Questions",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        3104,
        368
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
