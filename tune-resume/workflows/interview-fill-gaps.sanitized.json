    {
      "id": "iv-0017",
      "name": "Pair Answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3328,
        368
      ],
      "parameters": {
        "jsCode": "const row = $input.first().json || {};\n\nlet state = {};\ntry { state = JSON.parse(row.payload || '{}'); } catch (e) { state = {}; }\n\nconst questions = state.questions || [];\nif (!questions.length) {\n  throw new Error('Could not restore the interview questions for execution ' + $execution.id + '. Nothing was written to the master facts file.');\n}\n\n// The gate node itself is restored on resume - it is the entry point - so this\n// reference is safe where pre-gate ones are not.\nconst raw = $('Ask Facts Questions').first().json || {};\nconst data = (raw.data && typeof raw.data === 'object') ? raw.data : raw;\n\nconst answers = [];\nconst skippedQuestions = [];\n\nfor (const q of questions) {\n  const a = String(data[q] === undefined || data[q] === null ? '' : data[q]).trim();\n  if (!a) { skippedQuestions.push(q); continue; }\n  answers.push({ question: q, answer: a });\n}\n\nreturn [{ json: {\n  answersJson: JSON.stringify(answers),\n  answeredCount: answers.length,\n  skippedCount: skippedQuestions.length,\n  slackChannel: state.slackChannel || '',\n  threadTs: state.threadTs || '',\n} }];"
      },
      "onError": "continueErrorOutput"
    },
