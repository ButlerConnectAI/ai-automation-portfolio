    {
      "id": "iv-0007",
      "name": "Build Facts Corpus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        480
      ],
      "parameters": {
        "jsCode": "const MAX_CHARS = 120000;\nconst parts = [];\nconst skipped = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const name = j.fileName || 'unnamed file';\n  const text = (j.extractedText || '').trim();\n  if (j.ok === false || !text) { skipped.push(name); continue; }\n  parts.push('===== SOURCE FILE: ' + name + ' =====\\n' + text);\n}\n\nif (!parts.length) {\n  throw new Error('No readable career material was found in the Drive source folder, so there is nothing to interview against.');\n}\n\nlet corpus = parts.join('\\n\\n');\nif (corpus.length > MAX_CHARS) corpus = corpus.slice(0, MAX_CHARS);\n\nconst trigger = $('Facts Channel').first().json || {};\n\nreturn [{ json: {\n  corpus,\n  fileCount: parts.length,\n  skippedFiles: skipped,\n  slackChannel: trigger.channel || '',\n  threadTs: trigger.ts || '',\n} }];"
      },
      "onError": "continueErrorOutput"
    },
