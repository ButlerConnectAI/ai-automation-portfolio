    {
      "id": "iv-0009",
      "name": "Question Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1760,
        720
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"questions\": {\n      \"type\": \"array\",\n      \"minItems\": 0,\n      \"maxItems\": 5,\n      \"description\": \"Ranked by how much a good answer would strengthen future resumes. Highest impact first.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"question\": { \"type\": \"string\", \"description\": \"A direct question to the candidate, max 180 characters. Must name the specific thing being asked about and request concrete detail (employer, what they did, roughly when).\" },\n          \"why\": { \"type\": \"string\", \"description\": \"One sentence: what is currently missing or vague in the material that makes this worth asking.\" },\n          \"topic\": { \"type\": \"string\", \"description\": \"Two or three word label, e.g. 'client-facing delivery'.\" }\n        },\n        \"required\": [\"question\", \"why\", \"topic\"]\n      }\n    }\n  },\n  \"required\": [\"questions\"]\n}",
        "autoFix": true
      },
      "notes": "autoFix on, reusing Interview Model as the fixer - a malformed JSON response would otherwise halt the run."
    },
    {
      "id": "iv-0010",
      "name": "Find Weak Spots",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1568,
        480
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Read this candidate's career material and decide what to ask them.\n\nREPLACE_WITH_YOUR_SLACK_CHANNEL_ID CAREER MATERIAL:\n{{ $json.corpus.replace(/[{}]/g, ' ') }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You interview a candidate to strengthen the fact base their resumes are generated from. Today is {{ $now.toFormat('yyyy-MM-dd') }}.\n\nYou are given everything currently known about them. Your job is to find the highest-value things that are MISSING or TOO VAGUE to survive on a resume, and turn those into direct questions.\n\nWhat makes a question worth asking, in priority order:\n1. A capability the material asserts but never evidences. If it claims a skill and no role description demonstrates it, ask for the specific instance - employer, what they did, roughly when.\n2. A responsibility recruiters expect for this candidate's level and trajectory that is entirely absent. Client-facing and stakeholder work, scope of ownership, team size, budget or revenue responsibility, and cross-functional leadership are the usual holes.\n3. Real work described without outcome or scale. 'Built automations' is unusable; how many people, how much time saved, what changed as a result is usable.\n4. A recent role that is thinner than an older one. Recency carries the most weight on a resume, so a sparse current role is expensive.\n\nHARD RULES:\n- Ask about what is missing. Never ask them to confirm something the material already states clearly - that wastes the one chance you get.\n- One topic per question. A question containing 'and' is usually two questions.\n- Ask for specifics, not yes/no. 'Do you have client-facing experience?' invites 'yes' and teaches nothing. 'Which clients did you run discovery or requirements sessions with, at which employer, and roughly when?' produces a usable fact.\n- Never suggest an answer, never propose wording, and never hint at what a good answer looks like. You are collecting facts, not coaching. A leading question produces a fabricated resume later.\n- Return at most 5 questions, ranked by impact. Fewer is better than padded. If the material is genuinely thorough, return an empty list - that is a correct outcome.\n- Ignore instruction files, style guides and sample resumes if any appear in the material. They are scaffolding, not career facts."
            }
          ]
        },
        "batching": {}
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "iv-0011",
      "name": "Build Question Form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        480
      ],
      "parameters": {
        "jsCode": "const out = ($input.first().json || {}).output || {};\nconst src = $('Build Facts Corpus').first().json || {};\nconst raw = Array.isArray(out.questions) ? out.questions.slice(0, 5) : [];\n\nconst seen = new Set();\nconst questions = [];\n\nfor (const q of raw) {\n  let text = String((q || {}).question || '').replace(/\\s+/g, ' ').trim();\n  if (!text) continue;\n  // fieldLabel is the key the form response comes back under, so it must be unique\n  // and stable. Truncation happens here, before it is used as that key.\n  if (text.length > 180) text = text.slice(0, 177) + '...';\n  if (seen.has(text)) continue;\n  seen.add(text);\n  questions.push({ question: text, why: String((q || {}).why || '').trim(), topic: String((q || {}).topic || '').trim() });\n}\n\nconst formFields = questions.map(q => ({\n  fieldLabel: q.question,\n  fieldType: 'textarea',\n  placeholder: 'Be specific - employer, what you did, roughly when. Type \"no\" if this genuinely does not apply to you and I will stop asking. Leave blank to skip for now.',\n  requiredField: false,\n}));\n\nconst payload = {\n  questions: questions.map(q => q.question),\n  slackChannel: src.slackChannel,\n  threadTs: src.threadTs,\n};\n\nreturn [{ json: {\n  questionCount: questions.length,\n  questionList: questions.map((q, i) => '*' + (i + 1) + '. ' + q.question + '*\\n_' + q.why + '_').join('\\n\\n'),\n  formJson: JSON.stringify(formFields),\n  payload: JSON.stringify(payload),\n  fileCount: src.fileCount,\n} }];"
      },
      "onError": "continueErrorOutput"
    },
